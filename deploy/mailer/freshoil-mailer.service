[Unit]
Description=FreshOil — приём заявок с сайта и отправка на почту
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=/etc/freshoil-mailer.env
ExecStart=/usr/bin/python3 __REPO_DIR__/deploy/mailer/mailer.py
Restart=always
RestartSec=3
DynamicUser=yes
StateDirectory=freshoil
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
